# Copy to .env and replace every placeholder locally. Never commit real values.

# Neon Postgres
POSTGRES_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth. Configure the callback URL:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bootstrap administrator; this address is always allowed and cannot be demoted.
SUPER_ADMIN_EMAIL=

# Magic-link email delivery (Resend)
RESEND_API_KEY=
EMAIL_FROM=Secret Santa <hello@example.com>

# Public app URL used when generating links in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Daily notification cron (Wave 6)
CRON_SECRET=replace-with-a-random-secret
