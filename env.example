# Copy this file to .env and replace the placeholders. Never commit real secrets.

# PostgreSQL (local Docker or hosted Neon)
POSTGRES_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Public app origin
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth callback: http://localhost:3000/api/auth/callback/google
# Add https://YOUR_PRODUCTION_HOST/api/auth/callback/google in Google Cloud too.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Initial administrator; this address is always allowed and cannot be demoted.
SUPER_ADMIN_EMAIL=

# Resend magic-link and notification email delivery
RESEND_API_KEY=
EMAIL_FROM=Secret Santa <hello@example.com>

# Daily Vercel notification cron authentication
CRON_SECRET=replace-with-a-random-secret

# Optional: enables hosted wishlist image uploads.
BLOB_READ_WRITE_TOKEN=

# Optional: link to an iOS Shortcut for saving product links from Safari.
NEXT_PUBLIC_IOS_SHORTCUT_URL=

# Optional: local Chromium path for product preview rendering.
CHROME_EXECUTABLE_PATH=
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# Optional synthetic seed safety opt-in; use only with NODE_ENV=development.
SEED_SYNTHETIC_DATA=
